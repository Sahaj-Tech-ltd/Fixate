{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fixate",
  "version": "0.1.0",
  "identifier": "app.fixate.desktop",
  "build": {
    "frontendDist": "../staticfiles",
    "devUrl": "http://localhost:18000",
    "beforeDevCommand": "FIXATE_MODE=desktop python manage.py runserver 127.0.0.1:18000 --noreload",
    "beforeBuildCommand": "python manage.py collectstatic --noinput"
  },
  "app": {
    "windows": [
      {
        "title": "Fixate",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
